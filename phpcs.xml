<?xml version="1.0"?>
<ruleset name="WPCAPTCHASHIELD">
    <description>
        PSR-12 formatting + WordPress SECURITY sniffs (kept, non-negotiable)
        + Slevomat modern-PHP rules + PHP 8.1 cross-version compatibility.
        WordPress *style* sniffs (Yoda, snake_case, tabs) are deliberately NOT used.
    </description>

    <!-- What to scan -->
    <file>src</file>
    <file>tests</file>
    <file>wp-captcha-shield.php</file>

    <!-- Never scan dependencies or build output -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <!-- CLI behaviour: only .php, progress + sniff codes, run in parallel -->
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="parallel" value="8"/>
    <arg value="ps"/>

    <!-- ============================================================
         1. FORMATTING — PSR-12 (this replaces PHP-CS-Fixer entirely)
         ============================================================ -->
    <rule ref="PSR12"/>

    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>secure-wp-mfa.php</exclude-pattern>
    </rule>

    <!-- ============================================================
         2. MODERN PHP — Slevomat: strict types, full type hints,
            tidy imports. This is what makes it read as a 2026 codebase.
         ============================================================ -->
    <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes">
        <properties>
            <property name="declareOnFirstLine" value="false"/>
            <property name="linesCountBeforeDeclare" value="1"/>
            <property name="spacesCountAroundEqualsSign" value="0"/>
        </properties>
    </rule>
    <rule ref="Squiz.ControlStructures.ControlSignature">
        <exclude name="Squiz.ControlStructures.ControlSignature.SpaceAfterCloseParenthesis"/>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint"/>
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
        <properties>
            <property name="searchAnnotations" value="true"/>
        </properties>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses"/>

    <!-- ============================================================
         3. SECURITY — WordPress security sniffs. KEPT ON PURPOSE.
            This is the automated escaping / nonce / sanitization /
            prepared-SQL review that an auth plugin must not skip.
         ============================================================ -->
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

    <!-- ============================================================
         4. PHP CROSS-VERSION COMPATIBILITY — floor is 8.1
            (we develop on 8.3; this catches accidental 8.2+ syntax).
         ============================================================ -->
    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- Tests don't need the full type-hint ceremony -->
    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
